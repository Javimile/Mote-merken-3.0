
---
const { mode = 'login', genders = [] } = Astro.props;
const isRegister = mode === 'register';
---

<section class="auth-page relative min-h-screen overflow-hidden bg-ink pt-28 pb-16">
  <div class="absolute inset-0">
    <img
      src="/assets/santiago.jpg"
      alt="Chile"
      class="h-full w-full object-cover opacity-20"
    />
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(7,11,13,.98),rgba(7,11,13,.9)_48%,rgba(7,11,13,.72))]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_75%_25%,rgba(185,138,72,.12),transparent_34%)]"></div>
  </div>

  <div class="container-page relative z-10 grid items-center gap-10 lg:grid-cols-[.86fr_1.14fr]">
    <div class="max-w-xl py-10">
      <p class="eyebrow">Traveler account</p>

      <h1 class="mt-4 font-serif text-5xl leading-[.98] md:text-7xl">
        {isRegister ? 'Create your travel profile.' : 'Welcome back.'}
      </h1>

      <p class="mt-6 max-w-lg text-sm leading-7 text-white/52">
        {isRegister
          ? 'Save your journeys, follow booking requests and keep every reservation in one secure place.'
          : 'Access your journeys, approval requests and future reservations with Mote Merkén.'}
      </p>

      <div class="mt-9 grid max-w-lg gap-3 sm:grid-cols-3">
        <div class="auth-benefit">
          <span>01</span>
          <b>Bookings</b>
          <small>Keep every request together.</small>
        </div>

        <div class="auth-benefit">
          <span>02</span>
          <b>Approvals</b>
          <small>Review dates before payment.</small>
        </div>

        <div class="auth-benefit">
          <span>03</span>
          <b>Trips</b>
          <small>Return to your journey anytime.</small>
        </div>
      </div>
    </div>

    <div class="auth-card mx-auto w-full max-w-xl">
      <div>
        <p class="text-[10px] font-bold uppercase tracking-[.2em] text-sand-light">
          {isRegister ? 'New traveler' : 'Traveler access'}
        </p>

        <h2 class="mt-2 font-serif text-3xl">
          {isRegister ? 'Create account' : 'Sign in'}
        </h2>
      </div>

      <button
        id="google-auth-button"
        class="google-auth-button mt-6"
        type="button"
        data-provider="google"
        data-auth-mode={mode}
      >
        <span class="google-g" aria-hidden="true">G</span>
        <b>{isRegister ? 'Continue with Google' : 'Sign in with Google'}</b>
      </button>

      <p
        id="google-auth-note"
        class="mt-2 text-center text-[11px] leading-5 text-white/32"
      >
        Google Identity Services ready for OAuth Client ID configuration.
      </p>

      <div class="auth-divider">
        <span>or continue with email</span>
      </div>

      <form
        id={isRegister ? 'register-form' : 'login-form'}
        class="grid gap-4"
        method="POST"
      >
        {isRegister && (
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="auth-field">
              <span>First name</span>
              <input
                id="auth-first-name"
                name="firstName"
                type="text"
                autocomplete="given-name"
                required
                placeholder="Matías"
              />
            </label>

            <label class="auth-field">
              <span>Last name</span>
              <input
                id="auth-last-name"
                name="lastName"
                type="text"
                autocomplete="family-name"
                required
                placeholder="Vergara"
              />
            </label>

            <label class="auth-field">
              <span>Gender</span>
              <select
                id="auth-gender"
                name="gender"
                required
                class="w-full rounded-md border border-white/10 bg-white/[0.04] px-4 py-3 text-sm text-white/60 outline-none transition focus:border-sand/40 focus:bg-white/[0.06]"
              >
                <option value="" disabled selected class="bg-ink text-white/60">
                  Gender
                </option>

                {genders
                  .filter((gender) => gender.par_cod_par !== 999)
                  .map((gender) => (
                    <option
                      value={gender.par_cod_par}
                      class="bg-ink text-white"
                    >
                      {gender.par_nom_par}
                    </option>
                  ))}
              </select>
            </label>
          </div>
        )}

        <label class="auth-field">
          <span>Email</span>
          <input
            id="auth-email"
            name="email"
            type="email"
            autocomplete="email"
            required
            placeholder="you@email.com"
          />
        </label>

        <label class="auth-field">
          <span>Password</span>
          <input
            id="auth-password"
            name="password"
            type="password"
            autocomplete={isRegister ? 'new-password' : 'current-password'}
            minlength="8"
            required
            placeholder="••••••••"
          />
        </label>

        {isRegister && (
          <label class="auth-field">
            <span>Confirm password</span>
            <input
              id="auth-password-confirm"
              name="passwordConfirm"
              type="password"
              autocomplete="new-password"
              minlength="8"
              required
              placeholder="••••••••"
            />
          </label>
        )}

        {isRegister ? (
          <label class="auth-check">
            <input id="auth-terms" type="checkbox" required />
            <span>I agree to the terms and privacy policy.</span>
          </label>
        ) : (
          <div class="flex items-center justify-between gap-4 text-xs">
            <label class="auth-check">
              <input id="auth-remember" type="checkbox" />
              <span>Remember me</span>
            </label>

            <button
              class="text-sand-light transition hover:text-white"
              type="button"
            >
              Forgot password?
            </button>
          </div>
        )}

        <button
          id="auth-submit"
          class="btn-primary mt-1 w-full"
          type="submit"
        >
          {isRegister ? 'Create my account' : 'Sign in'}
          <span>→</span>
        </button>

        <div
          id="auth-feedback"
          role="status"
          aria-live="polite"
          class="hidden rounded-md border border-sand/20 bg-sand/[.06] p-3 text-xs leading-5 text-white/55"
        ></div>
      </form>

      <p class="mt-6 text-center text-xs text-white/38">
        {isRegister ? 'Already have an account?' : 'New to Mote Merkén?'}
        <a
          href={isRegister ? '/login' : '/register'}
          class="ml-1 font-bold text-sand-light transition hover:text-white"
        >
          {isRegister ? 'Sign in' : 'Create account'}
        </a>
      </p>
    </div>
  </div>
</section>

<script>
  const loginForm =
    document.querySelector<HTMLFormElement>('#login-form');

  if (loginForm) {
    loginForm.addEventListener('submit', async (event) => {
      event.preventDefault();

      const emailInput =
        document.querySelector<HTMLInputElement>('#auth-email');

      const passwordInput =
        document.querySelector<HTMLInputElement>('#auth-password');

      const feedback =
        document.querySelector<HTMLDivElement>('#auth-feedback');

      const submitButton =
        document.querySelector<HTMLButtonElement>('#auth-submit');

      if (!emailInput || !passwordInput || !feedback || !submitButton) {
        return;
      }

      const correo = emailInput.value.trim();
      const password = passwordInput.value;

      feedback.classList.remove('hidden');
      feedback.textContent = 'Iniciando sesión...';
      submitButton.disabled = true;

      try {
        // Obtener el token CSRF de Django.
        const csrfResponse = await fetch(
          'http://localhost:8000/api/csrf/',
          {
            method: 'GET',
            credentials: 'include',
            headers: {
              Accept: 'application/json',
            },
          }
        );

        if (!csrfResponse.ok) {
          throw new Error(
            `No se pudo obtener el token CSRF (${csrfResponse.status}).`
          );
        }

        const csrfData = await csrfResponse.json();

        if (!csrfData.csrfToken) {
          throw new Error('Django no devolvió el token CSRF.');
        }

        // Enviar las credenciales a Django.
        const loginResponse = await fetch(
          'http://localhost:8000/api/login/',
          {
            method: 'POST',
            credentials: 'include',
            headers: {
              Accept: 'application/json',
              'Content-Type': 'application/json',
              'X-CSRFToken': csrfData.csrfToken,
            },
            body: JSON.stringify({
              correo,
              password,
            }),
          }
        );

        const data = await loginResponse.json().catch(() => ({}));

        if (!loginResponse.ok) {
          feedback.textContent =
            data.error ||
            `No fue posible iniciar sesión (HTTP ${loginResponse.status}).`;
          return;
        }

        if (data.autenticado === false) {
          feedback.textContent =
            data.error || 'Las credenciales no son válidas.';
          return;
        }

        feedback.textContent = 'Inicio de sesión correcto.';

        console.log('Usuario autenticado:', data.usuario);

        window.location.href = '/';
      } catch (error) {
        console.error('Error durante el inicio de sesión:', error);

        feedback.textContent =
          error instanceof TypeError
            ? 'No fue posible conectar con Django. Revisa el servidor y CORS.'
            : error instanceof Error
              ? error.message
              : 'Ocurrió un error inesperado.';
      } finally {
        submitButton.disabled = false;
      }
    });
  }
</script>

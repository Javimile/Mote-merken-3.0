    /* =========================================================
       KEYBOARD AUTOCOMPLETE
    ========================================================== */

    search.addEventListener(
      'keydown',
      (event) => {

        const items =
          [
            ...suggestions.querySelectorAll(
              '.admin-tour-suggestion'
            ),
          ];


        if (!items.length) {
          return;
        }


        /*
         * Arrow Down
         */

        if (event.key === 'ArrowDown') {

          event.preventDefault();


          selectedSuggestion =
            Math.min(
              selectedSuggestion + 1,
              items.length - 1
            );


          items.forEach(
            (item, index) => {

              item.classList.toggle(
                'is-selected',
                index === selectedSuggestion
              );

            }
          );

        }


        /*
         * Arrow Up
         */

        if (event.key === 'ArrowUp') {

          event.preventDefault();


          selectedSuggestion =
            Math.max(
              selectedSuggestion - 1,
              0
            );


          items.forEach(
            (item, index) => {

              item.classList.toggle(
                'is-selected',
                index === selectedSuggestion
              );

            }
          );

        }


        /*
         * Enter
         */

        if (event.key === 'Enter') {

          event.preventDefault();


          if (selectedSuggestion >= 0) {

            items[selectedSuggestion].click();

          }

        }


        /*
         * Escape
         */

        if (event.key === 'Escape') {

          suggestions.hidden = true;

          selectedSuggestion = -1;

        }

      }
    );



       CLEAR SEARCH
    ========================================================== */

    function limpiarBusqueda() {

      search.value = '';

      suggestions.innerHTML = '';

      suggestions.hidden = true;

      selectedSuggestion = -1;

      searchClear.hidden = true;

      applyFilters();

      search.focus();


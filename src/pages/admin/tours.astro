  const duration = document.querySelector('#tour-duration').value.trim();
  const status = document.querySelector('#tour-active').value;
  const capacityValue = document.querySelector('#tour-capacity').value;

  const hoursMatch = duration.match(/(\d+(?:[.,]\d+)?)\s*hours?/i);
  const durationHours = hoursMatch
    ? Number(hoursMatch[1].replace(',', '.'))
    : null;

  const capacity = capacityValue === ''
    ? null
    : Number(capacityValue);

  const payload = {
    tou_nom_tou: name,
    tou_des_tou: description,
    tou_dur_hor: durationHours,
    tou_dur_dia: null,
    tou_cup_max: capacity,
    tou_est_tou: status === 'Active' ? 'activo' : 'inactivo',
  };

  try {
    const csrfToken = await obtenerTokenCSRF();

    const editing = Boolean(editingRow);
    const url = editing
      ? `${API_URL}/tours/${editingRow.dataset.id}/editar/`
      : `${API_URL}/tours/crear/`;

    const response = await fetch(url, {
      method: editing ? 'PUT' : 'POST',
      credentials: 'include',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRFToken': csrfToken,
      },
      body: JSON.stringify(payload),
    });

    const result = await response.json().catch(() => ({}));

    if (!response.ok) {
      throw new Error(
        result.error || `Error HTTP ${response.status}`
      );
    }

    dialog.close();
    reset();

    await cargarToursDesdeDjango();

    showToast(
      editing
        ? 'Tour actualizado correctamente.'
        : 'Tour creado correctamente.'
    );
  } catch (error) {
    console.error('Error al guardar el tour:', error);
    showToast(error.message || 'No se pudo guardar el tour.');
  }
});


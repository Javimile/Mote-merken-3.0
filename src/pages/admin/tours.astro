  form.addEventListener('submit', async (event) => {
    event.preventDefault();

    const message = form.querySelector(
      '#activity-form-message'
    );
    const submitButton = form.querySelector(
      'button[type="submit"]'
    );

    const formData = new FormData(form);

    const payload = {
      itd_dia_num: Number(formData.get('day')),
      itd_ord_itd: Number(formData.get('order')),
      itd_tit_itd: String(formData.get('title')).trim(),
      itd_des_itd:
        String(formData.get('description')).trim() || null,
      itd_hor_ref:
        String(formData.get('hour')).trim() || null,
    };

    if (
      !payload.itd_dia_num ||
      payload.itd_dia_num < 1 ||
      !payload.itd_ord_itd ||
      payload.itd_ord_itd < 1 ||
      !payload.itd_tit_itd
    ) {
      message.textContent =
        'Completa el día, el orden y el título correctamente.';
      return;
    }

    submitButton.disabled = true;
    message.textContent = 'Guardando actividad...';

    try {
      const csrfResponse = await fetch(`${API_URL}/csrf/`, {
        method: 'GET',
        credentials: 'include',
      });

      if (!csrfResponse.ok) {
        throw new Error('No se pudo obtener el token CSRF.');
      }

      const csrfData = await csrfResponse.json();

      if (!csrfData.csrfToken) {
        throw new Error('La respuesta no contiene el token CSRF.');
      }

      const response = await fetch(
        `${API_URL}/itinerarios/${itinerary.iti_id_iti}/actividades/crear/`,
        {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRFToken': csrfData.csrfToken,
          },
          credentials: 'include',
          body: JSON.stringify(payload),
        }
      );

      const result = await response.json().catch(() => null);

      if (!response.ok) {
        throw new Error(
          result?.error ||
          result?.detail ||
          result?.message ||
          `Error HTTP ${response.status}`
        );
      }

      message.textContent = 'Actividad guardada correctamente.';

      const activitiesResponse = await fetch(
        `${API_URL}/itinerarios/${itinerary.iti_id_iti}/actividades/`,
        { credentials: 'include' }
      );

      if (!activitiesResponse.ok) {
        throw new Error(
          'La actividad se guardó, pero no se pudo actualizar la lista.'
        );
      }

      const activities = await activitiesResponse.json();

      if (!Array.isArray(activities)) {
        throw new Error(
          'La actividad se guardó, pero la respuesta de la lista no es válida.'
        );
      }

      renderizarItinerario(itinerary, activities);
    } catch (error) {
      console.error('Error guardando actividad:', error);
      message.textContent =
        error.message || 'No se pudo guardar la actividad.';
      submitButton.disabled = false;
    }
  });

  form.scrollIntoView({
    behavior: 'smooth',
    block: 'center',
  });

  form.querySelector('#activity-title').focus();
}




          .toLowerCase();


      suggestions.innerHTML = '';

      selectedSuggestion = -1;


      /*
       * Si no hay búsqueda:
       * cerramos sugerencias.
       */

      if (!query) {

        suggestions.hidden = true;

        searchClear.hidden = true;

        applyFilters();

        return;

      }


      searchClear.hidden = false;


      /*
       * Buscamos por:
       * - nombre
       * - ID
       * - estado
       * - descripción
       */

      const coincidencias =
        loadedTours
          .filter((tour) => {

            const nombre =
              String(
                tour.tou_nom_tou ?? ''
              ).toLowerCase();


            const id =
              String(
                tour.tou_id_tou ?? ''
              ).toLowerCase();


            const estado =
              String(
                tour.tou_est_tou ?? ''
              ).toLowerCase();


            const descripcion =
              String(
                tour.tou_des_tou ?? ''
              ).toLowerCase();


            return (
              nombre.includes(query) ||
              id.includes(query) ||
              estado.includes(query) ||
              descripcion.includes(query)
            );

          })
          .slice(0, 6);


      /*
       * Sin resultados.
       */

      if (!coincidencias.length) {

        suggestions.innerHTML = `
          <div class="admin-tour-no-results">
            No se encontraron tours.
          </div>
        `;

        suggestions.hidden = false;

        applyFilters();

        return;

      }


      /*
       * Construimos las recomendaciones.
       */

      coincidencias.forEach((tour) => {

        const button =
          document.createElement('button');


        button.type = 'button';

        button.className =
          'admin-tour-suggestion';


        button.innerHTML = `

          <span class="admin-tour-suggestion-name">
            ${escapeHtml(tour.tou_nom_tou)}
          </span>


          <span class="admin-tour-suggestion-meta">

            ID ${tour.tou_id_tou}

            ·

            ${escapeHtml(
              tour.tou_est_tou ?? 'Sin estado'
            )}

            ${
              tour.tou_dur_hor
                ? ` · ${tour.tou_dur_hor} h`
                : ''
            }

          </span>

        `;


        button.addEventListener(
          'click',
          () => {

            seleccionarTour(tour);

          }
        );


        suggestions.appendChild(button);

      });


      suggestions.hidden = false;


      /*
       * También actualizamos la tabla
       * mientras se escribe.
       */

      applyFilters();

    }



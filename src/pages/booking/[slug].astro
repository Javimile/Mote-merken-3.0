
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BookingFlow from '../../components/booking/BookingFlow.astro';
import { tours } from '../../data/tours';
import { getBookingSeed } from '../../data/booking';

const { slug } = Astro.params;
const tour = tours.find((item) => item.slug === slug);
const booking = tour ? getBookingSeed(tour.slug) : undefined;
---

{tour && booking ? (
  <BaseLayout title={`Book ${tour.name} | Mote Merkén Travel`}>
    <Header active="booking" />
    <main class="min-h-screen bg-ink pt-20">
      <section class="relative overflow-hidden border-b border-white/10 bg-panel py-14 md:py-16">
        <div class="absolute inset-0 opacity-[.14]">
          <img src={tour.image} alt="" class="h-full w-full object-cover" />
        </div>
        <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/95 to-ink/65"></div>
        <div class="container-page relative z-10">
          <a href={`/tours/${tour.slug}`} class="route-link">
            ← Back to {tour.name}
          </a>
          <p class="eyebrow mt-6">Private journeys · Reservation</p>
          <h1 class="mt-3 max-w-3xl font-serif text-4xl md:text-6xl">
            Plan your journey
          </h1>
          <p class="mt-4 max-w-2xl text-sm leading-7 text-white/55">
            Choose your preferred date, schedule and number of travellers.
          </p>
        </div>
      </section>

      <section class="container-page py-12 md:py-16">
        <BookingFlow tour={tour} booking={booking} />
      </section>
    </main>
    <Footer />
  </BaseLayout>
) : (
  <BaseLayout title="Tour no disponible | Mote Merkén Travel">
    <Header />
    <main class="min-h-screen bg-ink pt-28">
      <div class="container-page py-16">
        <h1 class="font-serif text-3xl">Tour no disponible</h1>
        <p class="mt-4 text-white/60">
          No encontramos este tour o no tiene una configuración de reserva.
        </p>
        <a href="/tours" class="route-link mt-6 inline-block">
          Volver a los tours
        </a>
      </div>
    </main>
    <Footer />
  </BaseLayout>
)}

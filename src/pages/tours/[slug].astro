
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { tours } from '../../data/tours';
import { obtenerTourPorId } from '../../lib/tours-api';

const { slug } = Astro.params;
const visual = tours.find((item) => item.slug === slug);

if (!visual) {
  return new Response('Tour no encontrado', { status: 404 });
}

let tourApi;

try {
  tourApi = await obtenerTourPorId(visual.apiId);
} catch (error) {
  console.error('Error consultando el tour en Django:', error);
  return new Response('No se pudo consultar el tour', { status: 502 });
}

if (!tourApi) {
  return new Response('Tour no disponible', { status: 404 });
}

const tour = {
  ...visual,
  id: String(tourApi.tou_id_tou),
  name: tourApi.tou_nom_tou,
  summary: tourApi.tou_des_tou ?? visual.summary,
  description: tourApi.tou_des_tou ?? visual.description,
};
---

<BaseLayout title={`${tour.name} | Mote Merkén Travel`}>
  <Header active="tours" />
  <main>
    <section class="relative min-h-[660px] overflow-hidden bg-black pt-20">
      <img src={tour.image} alt={tour.name} class="absolute inset-0 h-full w-full object-cover"/>
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/35 to-black/10"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-ink via-transparent to-black/10"></div>
      <div class="container-page relative z-10 flex min-h-[580px] items-end pb-16 pt-20">
        <div class="max-w-3xl">
          <p class="eyebrow">{tour.eyebrow}</p>
          <h1 class="mt-4 font-serif text-6xl md:text-8xl">{tour.name}</h1>
          <p class="mt-4 text-sm uppercase tracking-[.16em] text-white/55">
            {tour.location} · {tour.region}
          </p>
          <p class="mt-6 max-w-2xl text-base leading-7 text-white/70">{tour.summary}</p>
        </div>
      </div>
    </section>

    <section class="py-20 md:py-24">
      <div class="container-page grid gap-12 lg:grid-cols-[1.4fr_.7fr]">
        <div>
          <p class="eyebrow">The Journey</p>
          <h2 class="mt-3 font-serif text-4xl">Designed as a private experience.</h2>
          <p class="mt-6 max-w-2xl text-sm leading-7 text-white/60">{tour.description}</p>
          <div class="mt-10 grid gap-3 sm:grid-cols-3">
            {tour.highlights.map((item) => (
              <div class="rounded-md border border-white/10 bg-white/[.025] p-5">
                <div class="mb-4 text-sand-light">✦</div>
                <p class="font-serif text-xl">{item}</p>
              </div>
            ))}
          </div>
        </div>

        <aside class="h-fit rounded-lg border border-white/10 bg-panel p-6 md:p-7">
          <p class="text-[10px] font-bold uppercase tracking-[.2em] text-sand-light">Booking information</p>
          <div class="mt-5 divide-y divide-white/10 text-sm">
            <div class="flex justify-between py-4"><span class="text-white/45">Travel style</span><b>{tour.format}</b></div>
            <div class="flex justify-between py-4"><span class="text-white/45">Experience</span><b>{tour.experience}</b></div>
            <div class="flex justify-between py-4"><span class="text-white/45">Schedule</span><b>On request</b></div>
            <div class="flex justify-between py-4"><span class="text-white/45">Rate</span><b>On request</b></div>
          </div>
          <a href={`/booking/${tour.slug}`} class="btn-primary mt-6 w-full">
            Reserve this journey <span>→</span>
          </a>
          <p class="mt-4 text-xs leading-5 text-white/35">
            Calendar, live availability and confirmed pricing will be connected to the Django API in the booking phase.
          </p>
        </aside>
      </div>
    </section>

    <section class="border-y border-white/10 bg-panel py-20">
      <div class="container-page">
        <p class="eyebrow">Next step</p>
        <div class="mt-3 flex flex-col justify-between gap-6 md:flex-row md:items-end">
          <div>
            <h2 class="font-serif text-4xl">Ready to continue?</h2>
            <p class="mt-3 text-sm text-white/50">Start the reservation flow or return to the complete tour collection.</p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a href="/tours" class="btn-secondary">All tours</a>
            <a href={`/booking/${tour.slug}`} class="btn-primary">Book Now <span>→</span></a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>



---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ToursHero from '../../components/tours/ToursHero.astro';
import TourCard from '../../components/tours/TourCard.astro';
import TourFilters from '../../components/tours/TourFilters.astro';
import { obtenerToursActivos } from '../../lib/tours-api';
import { tours as toursVisuales } from '../../data/tours';

let tours = [];
let errorCatalogo = false;

try {
  const toursApi = await obtenerToursActivos();

  tours = toursApi.map((tourApi) => {
    const visual = toursVisuales.find(
      (tour) => tour.apiId === tourApi.tou_id_tou
    );

    return {
      id: String(tourApi.tou_id_tou),
      apiId: tourApi.tou_id_tou,
      destinationId: visual?.destinationId ?? '',
      slug: visual?.slug ?? `tour-${tourApi.tou_id_tou}`,
      name: tourApi.tou_nom_tou,
      location: visual?.location ?? 'Chile',
      region: visual?.region ?? 'Chile',
      image: visual?.image ?? '/assets/baltinache.jpg',
      eyebrow: visual?.eyebrow ?? 'Tour disponible',
      summary: tourApi.tou_des_tou ??
        'Consulta los detalles de esta experiencia.',
      description: tourApi.tou_des_tou ??
        'Consulta los detalles de esta experiencia.',
      experience: visual?.experience ?? 'Nature',
      format: visual?.format ?? 'Private',
      highlights: visual?.highlights ?? [],
      latitude: visual?.latitude ?? -33.4489,
      longitude: visual?.longitude ?? -70.6693,
      capacidadMaxima: tourApi.tou_cup_max,
      duracionHoras: tourApi.tou_dur_hor,
      duracionDias: tourApi.tou_dur_dia,
    };
  });
} catch (error) {
  console.error('No se pudo cargar el catálogo de Django:', error);
  errorCatalogo = true;
}
---

<BaseLayout title="Tours in Chile | Mote Merkén Travel">
  <Header active="tours" />

  <main>
    <ToursHero />

    <section class="py-20 md:py-24">
      <div class="container-page">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="eyebrow">Our Collection</p>
            <h2 class="mt-3 font-serif text-4xl md:text-5xl">
              Choose where the story begins.
            </h2>
          </div>

          <p class="max-w-lg text-sm leading-6 text-white/50">
            Explora las experiencias disponibles en nuestro catálogo.
          </p>
        </div>

        <div class="mt-8">
          <TourFilters />
        </div>

        {errorCatalogo ? (
          <p class="mt-8 rounded-md border border-white/10 p-6 text-white/70">
            No pudimos cargar los tours. Comprueba que Django esté funcionando e inténtalo nuevamente.
          </p>
        ) : tours.length > 0 ? (
          <div class="mt-8 grid gap-5 md:grid-cols-2">
            {tours.map((tour) => <TourCard tour={tour} />)}
          </div>
        ) : (
          <p class="mt-8 rounded-md border border-white/10 p-6 text-white/70">
            Actualmente no hay tours activos disponibles.
          </p>
        )}
      </div>
    </section>

    <section class="border-y border-white/10 bg-panel py-20">
      <div class="container-page flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
        <div>
          <p class="eyebrow">Private Travel</p>
          <h2 class="mt-3 max-w-2xl font-serif text-4xl">
            Looking for a journey built around you?
          </h2>
          <p class="mt-3 max-w-xl text-sm leading-6 text-white/55">
            Tell us where you want to go and we will shape the itinerary around your travel style.
          </p>
        </div>

        <a href="/contact" class="btn-primary">
          Plan my journey <span>→</span>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
